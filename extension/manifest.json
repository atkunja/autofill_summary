{
  "manifest_version": 3,
  "name": "Apply, personally",
  "version": "0.3.1",
  "description": "Your details, your voice. Review job application autofills and optional AI drafts.",
  "minimum_chrome_version": "119",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Apply, personally"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  }
}
